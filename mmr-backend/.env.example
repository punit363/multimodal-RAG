# Required for embeddings, multimodal summaries, and answer generation.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Runtime safety limits.
RAG_MAX_UPLOAD_BYTES=26214400
RAG_MAX_PDF_PAGES=200
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_RETRIEVAL_MODE=hybrid
RAG_RERANK_ENABLED=true
RAG_QUERY_REWRITE_ENABLED=true
RAG_OCR_LANGUAGES=en,hi,es,fr
# Single-owner local usage controls; lower limits for paid-model protection.
RAG_RATE_CHAT=30
RAG_DAILY_QUOTA_CHAT=1000
RAG_RATE_INGEST=10
RAG_DAILY_QUOTA_INGEST=100
RAG_MAX_DOCUMENTS=500
RAG_INGEST_MODE=inline
# Required to enable sharing; set a random secret of at least 32 characters.
# When set, private API routes require the owner login cookie.
RAG_OWNER_API_KEY=

# Persistent local paths and browser origins.
RAG_DATABASE_PATH=rag_history.db
RAG_UPLOAD_DIR=docs
RAG_VECTOR_DIR=db/chroma_db
RAG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 5 High: use a separate PostgreSQL database, S3 prefix, and vector volume
# per workspace. Staging/production load secrets from *_FILE mounts.
# RAG_DEPLOYMENT_MODE=production
# RAG_WORKSPACE_ID=team-a
# RAG_DATABASE_URL_FILE=/run/secrets/database_url
# RAG_OWNER_API_KEY_FILE=/run/secrets/owner_key
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# RAG_ORIGINALS_BUCKET=private-bucket
# RAG_ORIGINALS_PREFIX=team-a/originals
# RAG_COOKIE_SECURE=true
