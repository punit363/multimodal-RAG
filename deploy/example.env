# Copy to an ignored file per environment; never commit actual secrets.
MMD_ENVIRONMENT=staging
MMD_WORKSPACE_ID=staging-team
MMD_PUBLIC_API_URL=https://api.staging.example.com
MMD_CORS_ORIGINS=https://staging.example.com
MMD_ORIGINALS_BUCKET=replace-with-private-bucket
MMD_ORIGINALS_PREFIX=staging-team/originals
MMD_OWNER_KEY_FILE=/absolute/path/to/owner-key
MMD_DATABASE_URL_FILE=/absolute/path/to/postgres-url
MMD_OPENAI_KEY_FILE=/absolute/path/to/openai-key
MMD_BACKEND_PORT=8000
MMD_FRONTEND_PORT=3000
